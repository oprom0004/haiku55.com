---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const { title, description, canonical, schema } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, 'https://haiku55.com').href;
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Pricing Calculator', href: '/#calculator' },
  { name: 'Benchmarks', href: '/benchmarks/' },
  { name: 'Pricing Guide', href: '/pricing/' },
  { name: 'API & SDKs', href: '/api/' },
  { name: 'FAQs', href: '/#faq' },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-haiku-void text-stone-100 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://haiku55.com/images/haiku55-og.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://haiku55.com/images/haiku55-og.jpg" />

    <!-- Structured Data -->
    {schema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(Array.isArray(schema) ? schema : [schema])}
      />
    )}
  </head>
  <body class="min-h-screen flex flex-col font-sans selection:bg-haiku-amber selection:text-black">
    
    <!-- Top Announcement Bar -->
    <div class="bg-gradient-to-r from-haiku-card via-haiku-border to-haiku-card border-b border-haiku-border text-[11px] sm:text-xs py-1.5 px-4 text-center text-stone-300 font-mono">
      <span class="inline-block px-1.5 py-0.5 rounded bg-haiku-amber/20 text-haiku-amber font-bold mr-2">PRE-RELEASE TRACKER</span>
      Claude Haiku 5.5 Official Announcement Confirmed • Projected Pricing: $0.25 / $1.25 per 1M Tokens!
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-haiku-void/90 border-b border-haiku-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-haiku-amber to-amber-700 flex items-center justify-center font-mono font-black text-black text-sm shadow-glow-amber group-hover:scale-105 transition-transform">
            H5
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-mono font-black text-lg text-white tracking-tight">HAIKU<span class="text-haiku-amber">5.5</span></span>
              <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-haiku-amber/15 text-haiku-amber border border-haiku-amber/30">AI</span>
            </div>
            <span class="hidden sm:block text-[10px] font-mono text-haiku-muted tracking-wider uppercase">
              Claude 5.5 Family Benchmark &amp; Pricing
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center gap-1 xl:gap-2 font-mono text-xs uppercase tracking-wider font-semibold">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href;
            return (
              <a
                href={link.href}
                class={`px-3 py-2 rounded-lg transition-all ${
                  isActive
                    ? 'bg-haiku-card text-haiku-amber border border-haiku-amber/40 shadow-sm'
                    : 'text-stone-300 hover:text-white hover:bg-haiku-card/60'
                }`}
              >
                {link.name}
              </a>
            );
          })}
        </nav>

        <!-- Right Quick Action -->
        <div class="flex items-center gap-2">
          <a
            href="/#calculator"
            class="px-4 py-2 rounded-lg bg-gradient-to-r from-haiku-amber to-amber-600 text-black font-mono font-bold text-xs uppercase tracking-wider shadow-glow-amber hover:brightness-110 transition-all flex items-center gap-1.5"
          >
            <span>Estimate Costs →</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="border-t border-haiku-border bg-haiku-card/70 mt-20 font-sans text-xs text-haiku-muted">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
          
          <div class="space-y-3 md:col-span-1">
            <div class="flex items-center gap-2">
              <span class="font-mono font-black text-white text-base">Haiku 5.5 Hub</span>
            </div>
            <p class="leading-relaxed">
              The premier developer guide, empirical benchmark monitor, and real-time Token cost calculator for Anthropic's upcoming Claude Haiku 5.5 model.
            </p>
          </div>

          <div>
            <h4 class="font-mono font-bold text-white text-xs uppercase tracking-wider mb-3">Model Analysis</h4>
            <ul class="space-y-2">
              <li><a href="/pricing/" class="hover:text-haiku-amber transition-colors">Projected Token Pricing Tiers</a></li>
              <li><a href="/pricing/#prompt-caching" class="hover:text-haiku-amber transition-colors">Prompt Caching 90% Savings</a></li>
              <li><a href="/benchmarks/" class="hover:text-haiku-amber transition-colors">Haiku 5.5 vs GPT-4o-mini</a></li>
              <li><a href="/benchmarks/#gemini" class="hover:text-haiku-amber transition-colors">Haiku 5.5 vs Gemini 2.5 Flash</a></li>
              <li><a href="/benchmarks/#sonnet" class="hover:text-haiku-amber transition-colors">Comparison to Claude Sonnet 5.5</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-mono font-bold text-white text-xs uppercase tracking-wider mb-3">Developer Resources</h4>
            <ul class="space-y-2">
              <li><a href="/api/" class="hover:text-haiku-amber transition-colors">Python SDK Quickstart</a></li>
              <li><a href="/api/#typescript" class="hover:text-haiku-amber transition-colors">TypeScript / Node.js Client</a></li>
              <li><a href="/api/#streaming" class="hover:text-haiku-amber transition-colors">Streaming &amp; Tool Calling</a></li>
              <li><a href="/#faq" class="hover:text-haiku-amber transition-colors">Frequently Asked Questions</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-mono font-bold text-white text-xs uppercase tracking-wider mb-3">Model Architecture</h4>
            <p class="leading-relaxed mb-3">
              Comprehensive technical guide and pricing reference for Claude 3.5 Haiku and high-throughput fast tier intelligence models.
            </p>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-haiku-void border border-haiku-border text-[11px] font-mono text-stone-300">
              Technical Documentation
            </div>
          </div>
        </div>

        <div class="pt-8 border-t border-haiku-border/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px]">
          <p>© 2026 haiku55.com • Independent Community Benchmark &amp; Pricing Resource.</p>
          <p class="text-stone-400 text-center sm:text-right max-w-xl">
            Disclaimer: haiku55.com is an independent community resource and benchmark guide. It is not affiliated with, sponsored by, or endorsed by Anthropic, PBC. Claude and Haiku are trademarks of Anthropic, PBC.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
